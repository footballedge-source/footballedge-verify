{
  "name": "footballedge-verify",
  "version": "0.1.0",
  "description": "Check that a FootballEdge football pick was sealed before kick-off: SHA-256, RFC 3161 timestamps (FreeTSA, DigiCert) and OpenTimestamps (Bitcoin).",
  "license": "MIT",
  "author": "FootballEdge (https://footballedge.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footballedge/footballedge-verify.git"
  },
  "bugs": {
    "url": "https://github.com/footballedge/footballedge-verify/issues"
  },
  "type": "module",
  "bin": {
    "footballedge-verify": "bin/footballedge-verify.js"
  },
  "exports": {
    ".": "./src/verify.js",
    "./ots": "./src/ots.js",
    "./tsr": "./src/tsr.js",
    "./manifest": "./src/manifest.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check bin/footballedge-verify.js && for f in src/*.js; do node --check \"$f\"; done"
  },
  "keywords": [
    "rfc3161",
    "timestamp",
    "opentimestamps",
    "bitcoin",
    "sha256",
    "verification",
    "football"
  ],
  "homepage": "https://footballedge.io/en/results/proof/verify"
}
